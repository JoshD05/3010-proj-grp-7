[Unit]
Description=Docker Webapp Container
Requires=docker.service
After=docker.service

[Service]
Type=simple
User=root
WorkingDirectory=/home/student/3010-proj-grp-7/docker-webapp
ExecStart=/usr/bin/docker run --name webapp -p 80:80 -p 5432:5432 webapp
ExecStop=/usr/bin/docker stop webapp
ExecStopPost=/usr/bin/docker rm webapp
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target 